# Training inside the language: the weights are `state`, and the `train`
# statement takes one optimizer step per run (one shared backward pass,
# AdamW moments kept as hidden state). Running `tgc batch` over a dataset is
# online training; `--save-state` exports the weights as raw f32 files that
# `param ... = file("...")` loads for deployment.
model train_xor

state w1 : f32[4, 2] = rand(1, 1)
state b1 : f32[4] = zeros
state w2 : f32[4] = rand(2, 1)
state b2 : f32 = 0

def net(x: f32[2]) -> f32:
    h = tanh(w1 @ x + b1)
    return sigmoid(dot(w2, h) + b2)

def forward(x: f32[2], target: f32) -> f32:
    p = net(x)
    train bce(p, target) with adamw(lr=0.02)
    return p
