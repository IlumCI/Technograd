param b15 : f32[7] = [0.207109895, 2.25511011, -3.06301861, -2.20444166, -0.125140065, 0.159142195, -1.63426564]
param q15 : f32[8] = [2.02212827, 7.65845044, 1.83992584, 1.99983748, -0.746089611, 0.520031757, 5.53182136, -7.96760992]

# Soft routing: d = sigmoid(z); log mu = -(path_l @ softplus(-z) + path_r @ softplus(z)).
def tree(x: f32[35], m: f32[35], w: f32[7, 35], b: f32[7], q: f32[8]) -> f32:
    z = w @ (x * m) + b
    mu = exp(-(path_l @ softplus(-z) + path_r @ softplus(z)))
    return dot(sigmoid(q), mu)

def forward(x: f32[35]) -> f32:
    s = tree(x, m0, w0, b0, q0)
    s = s + tree(x, m1, w1, b1, q1)
    s = s + tree(x, m2, w2, b2, q2)
    s = s + tree(x, m3, w3, b3, q3)
    s = s + tree(x, m4, w4, b4, q4)
    s = s + tree(x, m5, w5, b5, q5)
    s = s + tree(x, m6, w6, b6, q6)
    s = s + tree(x, m7, w7, b7, q7)
    s = s + tree(x, m8, w8, b8, q8)
    s = s + tree(x, m9, w9, b9, q9)
    s = s + tree(x, m10, w10, b10, q10)
    s = s + tree(x, m11, w11, b11, q11)
    s = s + tree(x, m12, w12, b12, q12)
    s = s + tree(x, m13, w13, b13, q13)
    s = s + tree(x, m14, w14, b14, q14)
    s = s + tree(x, m15, w15, b15, q15)
    p = min(max(s / 16, 0.000001), 0.999999)
    return sigmoid(cal_a * log(p / (1 - p)) + cal_b)
