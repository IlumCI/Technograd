# The gradient of a memory_scan with respect to its values: runs memscan_t,
# which steps backwards from the final memory undoing each write.
model mscang

param M0 : f32[6, 3] = rand(1, 1)
param I : f32[4, 2, 2] = [[[0, 4], [3, 5]], [[1, 4], [3, 3]], [[0, 2], [5, 4]], [[4, 1], [3, 0]]]
param A : f32[4, 2, 2] = rand(2, 1)
param C : f32[4, 2, 2] = rand(3, 0.8)
param W : f32[4, 2, 3] = rand(4, 1)
param e0 : f32[1, 3] = [[1, 0, 0]]
param e1 : f32[1, 3] = [[0, 1, 0]]
param e2 : f32[1, 3] = [[0, 0, 1]]

def forward(v: f32[4, 2, 3]) -> f32[4, 2, 3]:
    P = reshape(I, 4, 2, 2, 1) * e0 + reshape(A, 4, 2, 2, 1) * e1 + reshape(C, 4, 2, 2, 1) * e2
    return grad(sum(memory_scan(M0, P, v) * W) + sum(memory_final(M0, P, v) * memory_final(M0, P, v)), v)
